<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Help Request Status</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <!-- Simple brand/header row -->
      <header class="status-header">
        <div class="status-logo">STORE</div>
      </header>

      <section class="status-card">
        <!-- Request title (you can later inject the real text) -->
        <h2 class="status-request-title">I need general help in this area</h2>

        <!-- Vertical stepper -->
        <div class="status-stepper" id="statusStepper">
          <!-- Step 1: Reviewing -->
          <div class="status-step step-reviewing is-active">
            <div class="status-step-marker-wrap">
              <div class="status-step-marker"></div>
              <div class="status-step-line"></div>
            </div>
            <div class="status-step-content">
              <div class="status-step-title">Reviewing</div>
              <div class="status-step-desc">
                Thank you. Someone will be with you shortly.
              </div>
            </div>
          </div>

          <!-- Step 2: Received -->
          <div class="status-step step-received">
            <div class="status-step-marker-wrap">
              <div class="status-step-marker"></div>
              <div class="status-step-line"></div>
            </div>
            <div class="status-step-content">
              <div class="status-step-title">Received</div>
              <div class="status-step-desc">
                Your request has been received by the store team.
              </div>
            </div>
          </div>

          <!-- Step 3: On the way -->
          <div class="status-step step-onway">
            <div class="status-step-marker-wrap">
              <div class="status-step-marker"></div>
              <!-- last step has no line, but we'll hide it via CSS -->
              <div class="status-step-line status-step-line-last"></div>
            </div>
            <div class="status-step-content">
              <div class="status-step-title">On the way</div>
              <div class="status-step-desc">
                An associate is on the way to help you in this area.
              </div>
            </div>
          </div>
        </div>

        <button type="button" class="status-cancel-button">CANCEL</button>
      </section>
    </main>

    <!-- Load external JavaScript file -->
    <script src="/js/call-status.js" data-request-id="<%= requestId %>"></script>
  </body>
</html>
