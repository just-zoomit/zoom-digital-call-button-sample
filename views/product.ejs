<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product.name %> | Product Details</title>
    <link rel="stylesheet" href="/styles.css" />
    <style>
      .product-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }

      .back-links {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
      }

      .back-link {
        color: #2b7de9;
        text-decoration: none;
      }

      .back-link:hover {
        text-decoration: underline;
      }

      .product-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-top: 2rem;
      }

      @media (max-width: 768px) {
        .product-layout {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }

      .product-info {
        padding: 1rem;
      }

      .product-info h1 {
        font-size: 2rem;
        margin: 0 0 1rem 0;
        color: #333;
      }

      .product-info .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
      }

      .product-info .meta-item {
        display: flex;
        flex-direction: column;
      }

      .product-info .meta-label {
        font-weight: 600;
        color: #555;
        margin-bottom: 0.25rem;
      }

      .product-info .meta-value {
        color: #777;
      }

      .product-info .meta-value.sku {
        font-family: monospace;
        background: #f5f5f5;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
      }

      .product-info .description-section {
        margin-top: 1.5rem;
      }

      .product-info .description-section h2 {
        font-size: 1.3rem;
        margin-bottom: 0.75rem;
        color: #333;
      }

      .product-info .description-section p {
        font-size: 1rem;
        line-height: 1.6;
        color: #555;
      }

      .qr-section {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      .qr-section h2 {
        font-size: 1.4rem;
        margin: 0 0 1rem 0;
        color: #333;
      }

      .qr-section p {
        margin: 0 0 1.5rem 0;
        color: #666;
        font-size: 1rem;
        line-height: 1.5;
      }

      .qr-code-container {
        background: white;
        padding: 1.5rem;
        border-radius: 8px;
        border: 1px solid #ddd;
        margin-bottom: 1rem;
      }

      .qr-code-container img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      .qr-instructions {
        font-size: 0.9rem;
        color: #777;
        margin-top: 1rem;
        padding: 1rem;
        background: #f9f9f9;
        border-radius: 8px;
      }

      .help-button {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.75rem 1.5rem;
        background: #2b7de9;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .help-button:hover {
        background: #1e5bb8;
      }
    </style>
  </head>
  <body>
    <div class="product-container">
      <div class="back-links">
        <a href="/search" class="back-link">← Back to Search</a>
        <% if (department) { %>
          <span>|</span>
          <a href="/departments/<%= department.id %>" class="back-link">← Back to <%= department.name %></a>
        <% } %>
      </div>

      <div class="product-layout">
        <div class="product-info">
          <h1><%= product.name %></h1>

          <div class="meta">
            <div class="meta-item">
              <span class="meta-label">SKU</span>
              <span class="meta-value sku"><%= product.sku %></span>
            </div>

            <div class="meta-item">
              <span class="meta-label">Location</span>
              <span class="meta-value"><%= product.aisle %></span>
            </div>

            <% if (department) { %>
              <div class="meta-item">
                <span class="meta-label">Department</span>
                <span class="meta-value"><%= department.name %></span>
              </div>
            <% } %>

            <% if (store) { %>
              <div class="meta-item">
                <span class="meta-label">Store</span>
                <span class="meta-value"><%= store.name %></span>
              </div>
            <% } %>
          </div>

          <div class="description-section">
            <h2>Product Details</h2>
            <p><%= product.description %></p>
          </div>
        </div>

        <div class="qr-section">
          <h2>Need Help In-Store?</h2>
          <p>Scan this QR code with your phone to request assistance from a store associate.</p>

          <div class="qr-code-container">
            <img src="<%= qrCodeDataUrl %>" alt="QR Code for <%= product.name %>" />
          </div>

          <div class="qr-instructions">
            <strong>How it works:</strong><br />
            1. Scan the QR code with your phone camera<br />
            2. Select what you need help with<br />
            3. A store associate will be notified immediately
          </div>

          <a href="<%= callUrl %>" class="help-button">
            Request Help Now
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
